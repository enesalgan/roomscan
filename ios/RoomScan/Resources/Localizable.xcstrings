    "Check your email to confirm your account, then sign in.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa tu correo para confirmar la cuenta y luego inicia sesión."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabını onaylamak için e-postanı kontrol et, sonra giriş yap."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता पुष्टि के लिए ईमेल देखें, फिर साइन इन करें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique seu e-mail para confirmar a conta e depois entre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите аккаунт по почте, затем войдите."
          }
        }
      }
    },
