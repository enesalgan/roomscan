        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य का नाम दें, पता पुष्टि करें, कमरा स्कैन करें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomeie o trabalho, confirme o endereço e escaneie o cômodo."
