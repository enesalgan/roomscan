    "Tap to scan. Address and name are filled in for you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para escanear. La dirección y el nombre se completan solos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokun ve tara. Adres ve isim otomatik dolar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन के लिए टैप करें। पता और नाम अपने आप भर जाते हैं।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para escanear. Endereço e nome são preenchidos automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы сканировать. Адрес и название заполнятся сами."
          }
        }
      }
    },
