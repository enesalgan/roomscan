    "Name the job, confirm the address, scan the room.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombra el trabajo, confirma la dirección y escanea la habitación."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşi adlandır, adresi onayla, odayı tara."
